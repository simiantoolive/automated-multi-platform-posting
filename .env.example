# Explicitly opt in to simulation for a credential-free demonstration.
# Set real only when you intend to publish to the configured accounts.
PUBLISH_MODE=mock
# Owner-only OAuth app setup. Users link their accounts on the homepage.
APP_BASE_URL=http://localhost:4000
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
HTTP_TIMEOUT_SECONDS=10
PLATFORM_TIMEOUT_SECONDS=35

FACEBOOK_GRAPH_VERSION=v27.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

LINKEDIN_API_VERSION=202609
LINKEDIN_AUTHOR_URN=
LINKEDIN_ACCESS_TOKEN=

# OAuth 2.0 PKCE USER access token, NOT an app-only bearer token.
X_USER_ACCESS_TOKEN=

MASTODON_BASE_URL=https://mastodon.social
MASTODON_TOKEN=

# The PDS that actually hosts your Bluesky account.
BLUESKY_BASE_URL=https://bsky.social
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
